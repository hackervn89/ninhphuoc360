# Ninhphuoc360 Editor — Custom Multi-Resolution Config
# Based on krpano 1.19 multires.config
# Output tiles directly into tours/<sceneName>/panos/ structure

# basic settings
panotype=autodetect
hfov=360

# output
flash=false
html5=true

# convert spherical/cylindrical to cubical
converttocube=true
converttocubelimit=360x45

# multiresolution settings
multires=true
tilesize=512
levels=auto
levelstep=2
maxsize=auto
maxcubesize=auto

# output images path — tiles go into the project's tours/ structure
tilepath=%OUTPUTPATH%/panos/%BASENAME%.tiles/[c/]l%Al/%Av/l%Al[_c]_%Av_%Ah.jpg

# preview pano settings
preview=true
graypreview=false
previewsmooth=25
previewpath=%OUTPUTPATH%/panos/%BASENAME%.tiles/preview.jpg

# thumbnail for editor sidebar (small 240x120 crop)
customimage[thumb].size=240
customimage[thumb].path=%OUTPUTPATH%/panos/thumb.jpg
customimage[thumb].imagesettings=jpegquality=80 jpegsubsamp=422 jpegoptimize=true

# xml output — scene definition
xml=true
xmlpath=%OUTPUTPATH%/scenes.xml

# NO html output (we have our own editor)
html=false

# compression settings
jpegquality=82
jpegsubsamp=422
jpegoptimize=false

# skin template — minimal, scene-only XML (no skin inclusion)
xmltemplate_scene=<scene name="%BASENAME%" title="%BASENAME%" thumburl="%OUTPUTPATH_REL%/panos/thumb.jpg">[NL][TAB]<image>[NL][TAB][TAB]<cube url="%OUTPUTPATH_REL%/panos/%BASENAME%.tiles/[c/]l%Al/%Av/l%Al[_c]_%Av_%Ah.jpg" />[NL][TAB]</image>[NL]</scene>
